{
  "name": "apple-hig-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "Community MCP tools inspired by Apple's HIG, helping developers apply Apple's design guidance effectively.",
  "license": "MIT",
  "author": "Yord (yordcode)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yordcode/apple-hig-mcp.git"
  },
  "homepage": "https://github.com/yordcode/apple-hig-mcp#readme",
  "bugs": {
    "url": "https://github.com/yordcode/apple-hig-mcp/issues"
  },
  "keywords": [
    "mcp",
    "apple",
    "hig",
    "design-system",
    "accessibility",
    "codex",
    "claude",
    "cursor"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "apple-hig-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "catalog",
    "design-system",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "sync-catalog": "tsx scripts/sync-catalog.ts",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  }
}
